# Cloudflare Workers static-assets redirects (_redirects). Local development
# handles the bare root in app/(root)/page.tsx; the edge rule provides the same
# deterministic English Stable entry point for the static deployment.

/  /en/stable  302
/en  /en/stable  302
/vi  /vi/stable  302

# Preserve old prefixless English docs links while keeping /en canonical.
/stable  /en/stable  301
/stable/*  /en/stable/:splat  301
/beta  /en/beta  301
/beta/*  /en/beta/:splat  301
/_showcase  /en/_showcase  301
