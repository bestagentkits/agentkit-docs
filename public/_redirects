# Cloudflare Workers static-assets redirects (_redirects).
# hideLocale: default-locale — en is prefixless; vi keeps /vi. Static export
# still emits files under /en/…; these rules rewrite or redirect at the edge
# (Next.js middleware is unavailable with output: 'export').

# En landing at bare root (rewrite — URL stays /)
/  /en  200

# Machine routes keep the /en prefix (must precede /en/* canonicalization)
/en/og/*  /en/og/:splat  200
/en/llms.mdx/*  /en/llms.mdx/:splat  200
/en/llms.txt  /en/llms.txt  200
/en/llms-full.txt  /en/llms-full.txt  200

# Explicit /en paths → canonical prefixless URLs
/en  /  301
/en/*  /:splat  301

# Prefixless en doc paths → internal static tree
/stable/*  /en/stable/:splat  200
/beta/*  /en/beta/:splat  200
/_showcase  /en/_showcase  200
