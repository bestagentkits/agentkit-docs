{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kit skill brief (kits-brief)",
  "description": "Committed FAITHFUL brief for one kit skill. English substrate at <kit>/<slug>.json; optional VI prose overlay at <kit>/<slug>.vi.json.",
  "$defs": {
    "flag": {
      "type": "object",
      "required": ["name", "desc"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Flag or positional token as written in SKILL.md (e.g. --fast, cm)."
        },
        "desc": {
          "type": "string",
          "description": "Short explanation taken from SKILL.md; empty when the source does not explain it."
        }
      }
    },
    "proseOverlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overview": { "type": "string" },
        "whenToUse": { "type": "string" },
        "flags": {
          "type": "array",
          "items": { "$ref": "#/$defs/flag" },
          "description": "Optional VI flag descs keyed by matching name; generator falls back to EN."
        },
        "subcommands": {
          "type": "array",
          "items": { "$ref": "#/$defs/flag" }
        }
      }
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "slug",
    "name",
    "syntax",
    "overview",
    "whenToUse",
    "invocation",
    "flags",
    "subcommands",
    "related",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": { "type": "string" },
    "name": {
      "type": "string",
      "description": "Skill name as in frontmatter (ak:cook)."
    },
    "syntax": {
      "type": "string",
      "description": "Usage line: slash + argument-hint (English tokens only)."
    },
    "overview": { "type": "string" },
    "whenToUse": { "type": "string" },
    "invocation": {
      "type": "object",
      "required": ["claude-code", "codex"],
      "additionalProperties": false,
      "properties": {
        "claude-code": { "type": "string" },
        "codex": { "type": "string" }
      }
    },
    "flags": { "type": "array", "items": { "$ref": "#/$defs/flag" } },
    "subcommands": { "type": "array", "items": { "$ref": "#/$defs/flag" } },
    "related": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Related skill slugs (ak-plan) mentioned in SKILL.md."
    },
    "guide": {
      "type": ["string", "null"],
      "description": "Optional relative guide path once topic guides exist (Phase 3)."
    },
    "provenance": {
      "type": "object",
      "required": ["contentHash", "train"],
      "additionalProperties": false,
      "properties": {
        "contentHash": { "type": "string" },
        "train": { "type": "string" }
      }
    }
  }
}
