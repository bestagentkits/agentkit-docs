{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kit facts (kits-raw)",
  "type": "object",
  "required": ["id", "name", "version", "description", "generatedFrom", "counts", "agents", "skills"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "tier": { "type": "string" },
    "generatedFrom": {
      "type": "object",
      "required": ["train", "runtime"],
      "properties": {
        "train": { "type": "string" },
        "runtime": { "type": "string" },
        "cacheRoot": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "required": ["skills", "agents"],
      "properties": {
        "skills": { "type": "integer" },
        "agents": { "type": "integer" }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "name", "slash", "category", "descriptionRaw"],
        "properties": {
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "slash": { "type": "string" },
          "category": { "type": "string" },
          "version": { "type": "string" },
          "descriptionRaw": { "type": "string" },
          "whenToUseRaw": { "type": "string" },
          "shared": { "type": "boolean" },
          "identicalAcrossKits": { "type": "boolean" },
          "contentHash": { "type": "string" }
        }
      }
    }
  }
}
