{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinAllExceptPeerDependencies"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 3,
  "packageRules": [
    {
      "description": "Group Fumadocs packages — they release in lockstep",
      "matchPackageNames": ["/^fumadocs/", "/^@fumadocs//"],
      "groupName": "fumadocs"
    },
    {
      "description": "Group Next.js + React core",
      "matchPackageNames": ["next", "react", "react-dom", "/^@types/react/"],
      "groupName": "next+react"
    }
  ]
}
