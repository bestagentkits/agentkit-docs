{
  "schema_version": 1,
  "static_assets": ["checksums.txt", "install.sh", "install.ps1"],
  "pre_provenance_assets": [
    "docs-bundle.tar.gz",
    "docs-bundle.tar.gz.sha256"
  ],
  "cli_archives": [
    "ak_{version}_darwin_amd64.tar.gz",
    "ak_{version}_darwin_arm64.tar.gz",
    "ak_{version}_linux_amd64.tar.gz",
    "ak_{version}_linux_arm64.tar.gz",
    "ak_{version}_windows_amd64.zip",
    "ak_{version}_windows_arm64.zip"
  ],
  "gui_targets": [
    {
      "name": "darwin_arm64",
      "arch": "arm64",
      "is_macos": true,
      "wails_platform": "darwin/arm64",
      "script": "bash scripts/build-gui-darwin.sh",
      "self_hosted_runner": ["self-hosted", "macOS", "ARM64", "agentkit"],
      "hosted_runner": ["macos-15"],
      "artifact": "ak-gui_{version}_darwin_arm64.zip"
    },
    {
      "name": "darwin_amd64",
      "arch": "amd64",
      "is_macos": true,
      "wails_platform": "darwin/amd64",
      "script": "bash scripts/build-gui-darwin.sh",
      "self_hosted_runner": ["self-hosted", "macOS", "ARM64", "agentkit"],
      "hosted_runner": ["macos-15"],
      "artifact": "ak-gui_{version}_darwin_amd64.zip"
    },
    {
      "name": "linux_amd64",
      "arch": "amd64",
      "is_macos": false,
      "wails_platform": "linux/amd64",
      "script": "bash scripts/build-gui-linux.sh",
      "self_hosted_runner": ["self-hosted", "Linux", "X64", "agentkit"],
      "hosted_runner": ["ubuntu-22.04"],
      "artifact": "ak-gui_{version}_linux_amd64.AppImage"
    },
    {
      "name": "windows_amd64",
      "arch": "amd64",
      "is_macos": false,
      "is_windows": true,
      "wails_platform": "windows/amd64",
      "script": "pwsh scripts/build-gui-windows.ps1 -Version $env:VERSION -Arch amd64 -OutDir dist/gui",
      "self_hosted_runner": ["self-hosted", "Windows", "X64", "agentkit"],
      "hosted_runner": ["windows-latest"],
      "artifact": "ak-gui_{version}_windows_amd64.zip"
    }
  ],
  "kit_packages": {
    "kits": ["bundle", "engineer", "marketing"],
    "registrable_kits": ["engineer", "marketing"],
    "runtimes": ["claude-code", "codex", "cursor", "grok", "omp", "pi"],
    "assets": [
      {"source": "kit.tar.gz", "suffix": "tar.gz"},
      {"source": "manifest.json", "suffix": "manifest.json"},
      {"source": "kit.tar.gz.sha256", "suffix": "sha256"}
    ]
  },
  "provenance_asset": "release-provenance.json"
}
